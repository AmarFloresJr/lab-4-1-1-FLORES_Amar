        <name>Lab 2.1.1 onCellEdit Alert</name>
        <order/>
        <script><![CDATA[function onCellEdit(sysIDs, tableName, fieldName, oldValue, newValue, callback) {
    // Debugging log (shows in JS Log window, not blocked by isolation)
    jslog("onCellEdit fired: table=" + tableName + " field=" + fieldName + " old=" + oldValue + " new=" + newValue);

    // Only act when the State field changes on the Incident table
    if (tableName === "incident" && fieldName === "state") {
        if (newValue === "6" || newValue === "7") {
            // Show a ServiceNow-safe message (instead of alert)
            g_form.showFieldMsg("state", "You cannot set State to Resolved or Closed from the list.", "error");
            callback(false); // cancel the change
            return;
        }
    }

    // Allow other edits
    callback(true);
}
]]></script>

        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Query 1: Incidents where Application = SAP
    var gr1 = new GlideRecord('incident');
    gr1.addQuery('x_1323558_scriptin_application', 'SAP'); 
    gr1.query();
    gs.info('=== Lab 6.1: Number of SAP incidents = ' + gr1.getRowCount());

    // Query 2: Incidents opened in the last 7 days
    var gdt = new GlideDateTime();
    gdt.addDaysUTC(-7); // go back 7 days
    var gr2 = new GlideRecord('incident');
    gr2.addQuery('opened_at', '>=', gdt);
    gr2.query();
    gs.info('=== Lab 6.1: Incidents opened in last 7 days = ' + gr2.getRowCount());

})(current, previous);
]]></script>
